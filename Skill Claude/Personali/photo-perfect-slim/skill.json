uct-white":{"description":"Standard e-commerce (Amazon-like) sfondo bianco puro","output":{"width":2000,"height":2000,"format":"jpg","quality":95,"color_space":"sRGB"},"crop":{"mode":"square","padding_pct":12,"subject_centered":true},"background":{"action":"replace","color":"#FFFFFF","shadow":{"enabled":true,"opacity":0.15,"blur":30,"offset_y":12,"type":"drop"}},"color":{"white_balance":"auto-grey-world","exposure_ev":"auto","saturation":1.0,"vibrance":1.03,"contrast":1.05},"detail":{"denoise":"light","sharpen":{"amount":0.5,"radius":1.0,"threshold":3}},"compliance":{"strip_exif":true,"no_watermark":true}},"portrait-natural":{"description":"Ritratto naturale (no over-processing)","output":{"format":"jpg","quality":94,"color_space":"sRGB","keep_dimensions":true},"background":{"action":"keep"},"color":{"white_balance":"auto-faces","exposure_ev":"auto","saturation":1.02,"vibrance":1.04,"contrast":1.03},"detail":{"denoise":"medium","sharpen":{"amount":0.4,"radius":1.0,"threshold":5},"skin_smoothing":"subtle"},"compliance":{"strip_exif":true}},"general-enhance":{"description":"Miglioramento generico bilanciato","output":{"format":"jpg","quality":92,"color_space":"sRGB","keep_dimensions":true},"background":{"action":"keep"},"color":{"white_balance":"auto-grey-world","exposure_ev":"auto","saturation":1.05,"vibrance":1.07,"contrast":1.06},"detail":{"denoise":"light","sharpen":{"amount":0.5,"radius":1.0,"threshold":3}},"compliance":{"strip_exif":true}},"restore-old":{"description":"Restauro foto vecchie/bassa risoluzione","output":{"format":"jpg","quality":95,"color_space":"sRGB","upscale":2.0},"background":{"action":"keep"},"color":{"white_balance":"auto-grey-world","exposure_ev":"auto","saturation":1.08,"vibrance":1.1,"contrast":1.1,"dehaze":0.3},"detail":{"denoise":"strong","sharpen":{"amount":0.7,"radius":1.3,"threshold":2},"upscale_model":"realesrgan-x2plus"},"ai":{"colorize_if_bw":"ask"}}},"vinted_pack_recipes":{"sweater":["front_flat","back_flat","label_close","detail_texture","defects_if_any"],"tshirt":["front_flat","back_flat","label_close","detail_print"],"jeans":["front_flat","back_flat","waist_label","hem_detail","fabric_close"],"dress":["front_hanger","back_hanger","label_close","detail_pattern"],"jacket":["front_flat","back_flat","lining","label_close","zipper_detail"],"shoes":["side_pair","top_pair","sole_pair","heel_detail","label_inside"],"bag":["front","back","inside","label_logo","hardware_close"],"generic":["main","secondary","detail","label_or_brand"]}},"prompts":{"version":"1.0.0","description":"Prompt AI per il Livello 3 (Gemini 3 Pro Image / FLUX.2 Pro via OpenRouter). Tutti i prompt rispettano le regole Vinted (no falsificazione difetti).","prompts":{"vinted_clothing_cleanup":"Professional e-commerce product photo of a single clothing item, perfectly flat-lay on a clean light gray (#F7F7F5) seamless background, soft diffused studio lighting from top-left, subtle natural shadow under the garment, the item is gently steamed and wrinkle-free but ALL existing colors, patterns, fabric texture, brand labels, stitching and any genuine wear must remain 100% unchanged and faithful to the original. Square 1:1 composition, centered, 8% padding. No text, no watermark, no logo overlay, no people, no extra props. Photorealistic, sharp focus, 1200x1200.","vinted_shoes_cleanup":"Professional e-commerce shoe product photo on pure white seamless background, 3/4 angle showing the upper and side profile, soft drop shadow beneath, studio lighting. Preserve ALL original colors, materials, scuffs, sole wear and brand details exactly as in the source. Square 1:1, centered with 8% padding. No text, no watermark, no people. Photorealistic, sharp, 1200x1200.","product_white_bg":"Clean Amazon-style product photography on pure white #FFFFFF seamless background. Single object centered with 12% padding, soft realistic drop shadow (15% opacity, 30px blur), even studio softbox lighting eliminating harsh highlights. Preserve original colors, materials and textures with absolute fidelity — do not invent details or remove genuine defects. Square 1:1, 2000x2000, photorealistic, tack sharp.","background_remove_only":"Isolate the main subject of this image with a precise alpha matte. Output the subject on transparent background. Preserve fine details: hair, fabric edges, fur, thin straps. Do not alter the subject's colors or texture in any way.","background_replace_studio":"Replace the background of this image with a clean professional studio backdrop ({color}). Keep the subject pixel-identical: same pose, same colors, same details, same shadows on the subject itself. Add a soft realistic contact shadow on the new background. Photorealistic compositing.","color_fidelity_fix":"Correct only the white balance and exposure of this photo to match neutral daylight (5500K). Do NOT change saturation, contrast or any other aspect. The goal is faithful color reproduction for e-commerce. Preserve all existing details.","denoise_lowlight":"Reduce noise and grain in this low-light photo while preserving fine detail and texture. Do not over-smooth. Keep natural skin/fabric texture. No color shift.","upscale_2x":"Upscale this image by 2x using detail-aware super-resolution. Preserve original style, colors and grain character. Do not invent or hallucinate details that were not present in the source.","wrinkle_reduce_subtle":"Gently reduce only obvious major wrinkles and fold creases on this garment, as if it had been lightly steamed. Preserve fabric texture, all colors, patterns, brand labels, stitching, and any signs of genuine wear (pilling, stains, tears) — these MUST remain visible and unchanged. Do not falsify the condition of the item."},"negative_prompts":{"common":"text, watermark, logo overlay, signature, copyright mark, people in frame (if product), extra objects, cluttered background, oversaturation, plastic skin, AI artifacts, distorted geometry, missing limbs, extra fingers, hallucinated details, fake brand labels"},"safety_rules":["Never hide or remove genuine product defects (stains, holes, pilling, scratches, fading)","Never alter brand labels, size tags or authenticity markers","Never change the actual color of the garment beyond white balance correction","Never add a watermark or logo","Never insert text into the image","If the user requests any of the above, refuse politely and explain the Vinted Terms of Service"]}}}