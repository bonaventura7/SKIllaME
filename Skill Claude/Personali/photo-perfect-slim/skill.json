il","label_or_brand"]},"compliance_rules":["Non aggiungere mai watermark, logo o testo sovraimpresso (Vinted ToS)","Non rimuovere mai difetti reali del prodotto (macchie, pilling, fori)","Non alterare brand label, etichette autenticità, hardware originale","Saturazione max +10%, vibrance max +15% per fedeltà colore","Rimuovere EXIF GPS (privacy utente)","Output sempre in sRGB (compatibilità marketplace)","Output ≤ 20 MB per immagine (limite Vinted)","Se l'utente chiede una modifica non compliant, RIFIUTARE gentilmente con spiegazione"],"commands":{"setup":"python scripts/setup.py","retouch":"python scripts/retouch.py <INPUT> --preset <NAME> --out <PATH>","vinted_pack":"python scripts/vinted_pack.py <DIR> --item-type <TYPE> --out <DIR>","batch":"python scripts/batch.py <DIR> --preset <NAME> --out <DIR> [--jobs N] [--recursive]","background":"python scripts/background.py <INPUT> --replace <COLOR|transparent> [--shadow] --out <PATH>","enhance":"python scripts/enhance.py <INPUT> --auto --out <PATH>","ai_edit":"python scripts/ai_edit.py <INPUT> --prompt <NAME> --out <PATH>"},"files":{"skill_definition":"SKILL.md","manifest":"plugin.json","presets":"assets/presets.json","ai_prompts":"assets/prompts.json","references":["references/vinted-playbook.md","references/product-shot.md","references/general-retouch.md","references/color-fidelity.md"],"scripts":["scripts/setup.py","scripts/retouch.py","scripts/vinted_pack.py","scripts/batch.py","scripts/background.py","scripts/enhance.py","scripts/ai_edit.py"]},"requirements":{"python":">=3.9","required":["Pillow>=10.0","numpy>=1.24"],"recommended":["opencv-python>=4.8","rembg>=2.0","onnxruntime>=1.16"],"optional":["requests>=2.31"]},"output_schema":{"status":"ok | degraded | partial | error","input":"string (path)","output":"array of strings (paths)","preset":"string","operations":"array of operation tags applied in order","fallback_level":"1 | 2 | 3","warnings":"array of strings","metrics":{"input_size_mb":"number","output_size_mb":"number","duration_s":"number","output_dims":"[w, h]"}},"install":{"via_skills_sh":"npx skills add your-org/photo-perfect","manual":["git clone <repo> ~/.claude/skills/photo-perfect","cd ~/.claude/skills/photo-perfect","python scripts/setup.py"],"verify":"python scripts/setup.py  # deve stampare status=ok"},"ecosystem_references":{"standard":"https://skills.sh","spec":"https://agentskills.io","inspired_by":["anthropics/skills (template, frontend-design)","AgriciDaniel/banana-claude (image-gen via Gemini)","K-Dense-AI generate-image (OpenRouter wrapper)","claude-skills-collection Image Enhancer","inference-sh/skills (multi-AI orchestration)"]},"plugin_manifest":{"homepage":"https://github.com/your-org/photo-perfect","keywords":["photo","image","vinted","ecommerce","retouch","product-photography","background-removal"],"skills":[{"name":"photo-perfect","path":"./SKILL.md","trigger_phrases":["ritocca foto","fix photo","enhance image","foto vinted","preparare foto vestito","scontorna","rimuovi sfondo","background remove","product shot","batch foto","set foto vinted"]}],"commands":{"photo:retouch":"python scripts/retouch.py","photo:vinted":"python scripts/vinted_pack.py","photo:batch":"python scripts/batch.py","photo:bg":"python scripts/background.py","photo:enhance":"python scripts/enhance.py","photo:ai":"python scripts/ai_edit.py","photo:setup":"python scripts/setup.py"},"requirements":{"python":">=3.9","pip":["Pillow>=10.0","numpy>=1.24"],"pip_recommended":["opencv-python>=4.8","rembg>=2.0","onnxruntime>=1.16"],"pip_optional":["requests>=2.31"],"env_optional":["OPENROUTER_API_KEY"]},"agents_compatible":["claude-code","cursor","codex","gemini","windsurf","cline","copilot","opencode","roo"],"install":{"npx":"npx skills add your-org/photo-perfect","manual":"git clone <repo> ~/.claude/skills/photo-perfect && cd ~/.claude/skills/photo-perfect && python scripts/setup.py"}},"assets":{"presets":{"$schema":"https://photo-perfect.dev/schemas/presets-v1.json","version":"1.0.0",