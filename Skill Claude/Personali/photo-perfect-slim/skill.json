{"$schema":"https://agentskills.io/schema/skill-v1.json","name":"photo-perfect","version":"1.0.0","description":"Skill agente HA (High-Availability) per ritocco foto end-to-end. Pipeline a 3 livelli con fallback automatico (Pillow → OpenCV+rembg → Cloud AI). Use case: foto generali, marketplace, focus Vinted (vestiti, scarpe, borse, oggetti singoli), product photography e-commerce.","author":{"name":"Senior Solutions Architect","experience_years":35,"specialization":"HA workflow design, photo pipelines"},"license":"MIT","language":"it","tags":["photo","image-editing","vinted","ecommerce","product-photography","retouch","background-removal","batch","HA","fallback"],"trigger_phrases":["ritocca foto","ritocco foto","migliora foto","fix photo","enhance image","foto vinted","preparare foto vinted","preparare foto vestito","scontorna","scontornare","rimuovi sfondo","background remove","product shot","foto prodotto","foto e-commerce","batch foto","set foto vinted","pacchetto foto vestito"],"agents_compatible":["claude-code","cursor","codex","gemini","windsurf","cline","github-copilot","opencode","roo","amp","trae"],"decision_tree":{"step_1_classify_subject":{"vestito_flat_lay":"preset:vinted-clothing","vestito_appeso":"preset:vinted-clothing","scarpe":"preset:vinted-shoes","borsa_accessorio":"preset:vinted-accessory","oggetto_singolo":"preset:product-white","ritratto":"preset:portrait-natural","lifestyle_generico":"preset:general-enhance","foto_vecchia":"preset:restore-old"},"step_2_count":{"1":"scripts/retouch.py","N":"scripts/batch.py","set_vinted_completo":"scripts/vinted_pack.py"},"step_3_destination":{"vinted":{"format":"jpg","dim":"1200x1200","max_mb":20,"color_space":"sRGB"},"ebay":{"format":"jpg","dim":"1600x1600","color_space":"sRGB"},"amazon":{"format":"jpg","dim":"2000x2000","bg":"#FFFFFF","fill_pct_min":85},"web":{"format":"jpg","quality":88},"stampa":{"format":"tiff","color_space":"AdobeRGB"}}},"pipeline_HA":{"level_1_local_basic":{"engine":"Pillow + NumPy","a